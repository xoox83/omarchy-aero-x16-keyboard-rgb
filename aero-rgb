#!/usr/bin/env python3
"""One-zone RGB for the Gigabyte AERO X16 keyboard (USB 0414:8204).

The board is a single HID LampArray lamp (interface 4 / …/input4).
The older Aorus 8-byte vendor report on interface 3 turns this firmware off —
do not use it.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import pathlib
import signal
import stat
import sys
import time

VID = 0x0414
PID = 0x8204
PHYS_SUFFIX = "/input4"
STATE_DIR_PARTS = (".config", "aero-rgb")
STATE_NAME = "state.json"
MAX_STATE_BYTES = 4096
UEVENT_MAX_BYTES = 4096

# HID LampArray (usage page 0x59)
REPORT_MULTIUPDATE = 0x04
REPORT_RANGEUPDATE = 0x05
REPORT_CONTROL = 0x06
MULTIUPDATE_LEN = 51  # id + count + flags + 8×u16 ids + 8×RGBI
RANGEUPDATE_LEN = 10  # id + flags + start + end + RGBI
RGBI_OFFSET = 19      # 1 + 2 + 16

NAMED = {
    "off": (0, 0, 0),
    "black": (0, 0, 0),
    "white": (255, 255, 255),
    "red": (255, 0, 0),
    "green": (0, 255, 0),
    "blue": (0, 80, 255),
    "cyan": (0, 200, 220),
    "magenta": (220, 0, 180),
    "yellow": (255, 200, 0),
    "orange": (255, 120, 0),
    "purple": (140, 0, 255),
}


def hid_ioc(nr: int, length: int) -> int:
    return 0xC0000000 | (length << 16) | (ord("H") << 8) | nr


def _read_uevent(path: pathlib.Path) -> str:
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
    try:
        data = os.read(fd, UEVENT_MAX_BYTES + 1)
    finally:
        os.close(fd)
    return data[:UEVENT_MAX_BYTES].decode(errors="replace")


def find_hidraw() -> pathlib.Path:
    root = pathlib.Path("/sys/class/hidraw")
    if not root.is_dir():
        raise SystemExit("no /sys/class/hidraw")
    hid_id = f"HID_ID=0003:{VID:08X}:{PID:08X}"
    found: list[tuple[str, str]] = []
    for node in sorted(root.glob("hidraw*")):
        uevent = _read_uevent(node / "device" / "uevent")
        if hid_id not in uevent:
            continue
        phys = ""
        for line in uevent.splitlines():
            if line.startswith("HID_PHYS="):
                phys = line.split("=", 1)[1]
        found.append((phys, node.name))
        if phys.endswith(PHYS_SUFFIX):
            return pathlib.Path("/dev") / node.name
    if found:
        hint = ", ".join(f"{name} ({phys})" for phys, name in found)
        raise SystemExit(f"0414:8204 found, but not LampArray (…{PHYS_SUFFIX}): {hint}")
    raise SystemExit("Gigabyte keyboard 0414:8204 not found")


def _verify_hidraw_fd(fd: int) -> None:
    """Confirm an already-opened fd really is the Gigabyte LampArray node.

    Binds the check to the retained descriptor (via /proc/self/fd) instead of
    trusting the path that was used to open it, so a swapped /dev node or an
    arbitrary --device argument is caught before any report is sent.
    """
    st = os.fstat(fd)
    if not stat.S_ISCHR(st.st_mode):
        raise SystemExit("opened device is not a character device")
    try:
        link = os.readlink(f"/proc/self/fd/{fd}")
    except OSError as e:
        raise SystemExit(f"could not resolve opened device: {e}") from e
    name = os.path.basename(link)
    if not name.startswith("hidraw"):
        raise SystemExit(f"opened device is not a hidraw node: {link}")
    try:
        uevent = _read_uevent(pathlib.Path("/sys/class/hidraw") / name / "device" / "uevent")
    except OSError as e:
        raise SystemExit(f"could not verify {name}: {e}") from e
    hid_id = f"HID_ID=0003:{VID:08X}:{PID:08X}"
    if hid_id not in uevent:
        raise SystemExit(f"{name} is not the Gigabyte keyboard ({hid_id})")
    phys = ""
    for line in uevent.splitlines():
        if line.startswith("HID_PHYS="):
            phys = line.split("=", 1)[1]
    if not phys.endswith(PHYS_SUFFIX):
        raise SystemExit(f"{name} is not the LampArray interface (…{PHYS_SUFFIX})")


def set_feature_fd(fd: int, data: bytes) -> None:
    buf = bytearray(data)
    fcntl.ioctl(fd, hid_ioc(0x06, len(buf)), buf, True)


def set_feature(dev: pathlib.Path, data: bytes) -> None:
    fd = os.open(dev, os.O_RDWR)
    try:
        _verify_hidraw_fd(fd)
        set_feature_fd(fd, data)
    except OSError as e:
        if e.errno in (1, 13):
            raise SystemExit(
                f"permission denied on {dev}. Need udev 99-aero-rgb.rules (group wheel)."
            ) from e
        raise SystemExit(f"HIDIOCSFEATURE failed on {dev}: {e}") from e
    finally:
        os.close(fd)


def build_rangeupdate(r: int, g: int, b: int) -> bytes:
    # LampRangeUpdate: flags, lampIdStart, lampIdEnd, RGBI
    return bytes(
        [
            REPORT_RANGEUPDATE,
            1,  # LampUpdateComplete
            0,
            0,  # start lamp 0
            0,
            0,  # end lamp 0
            r & 0xFF,
            g & 0xFF,
            b & 0xFF,
            0xFF,
        ]
    )


def apply_lamp(dev: pathlib.Path, r: int, g: int, b: int) -> None:
    """Take host control once, then set the single lamp via range + multi update.

    Re-sending AutonomousMode=0 on a *closed* fd every invocation was enough
    to make ioctl succeed while the firmware kept the previous colour.
    Keep the fd open and send range-update (the 1-zone report) last.
    """
    fd = os.open(dev, os.O_RDWR)
    try:
        _verify_hidraw_fd(fd)
        try:
            set_feature_fd(fd, bytes([REPORT_CONTROL, 0]))
        except OSError:
            pass
        set_feature_fd(fd, build_multiupdate(r, g, b))
        set_feature_fd(fd, build_rangeupdate(r, g, b))
    except OSError as e:
        if e.errno in (1, 13):
            raise SystemExit(
                f"permission denied on {dev}. Need udev 99-aero-rgb.rules (group wheel)."
            ) from e
        raise SystemExit(f"HIDIOCSFEATURE failed on {dev}: {e}") from e
    finally:
        os.close(fd)


def scale_rgb(r: int, g: int, b: int, pct: int) -> tuple[int, int, int]:
    pct = max(0, min(100, pct))
    return (round(r * pct / 100), round(g * pct / 100), round(b * pct / 100))


def build_multiupdate(r: int, g: int, b: int) -> bytes:
    rpt = bytearray(MULTIUPDATE_LEN)
    rpt[0] = REPORT_MULTIUPDATE
    rpt[1] = 1  # one lamp
    rpt[2] = 1  # LampUpdateComplete
    # lamp id 0 at offset 3, remaining 7 ids stay 0
    rpt[RGBI_OFFSET] = r & 0xFF
    rpt[RGBI_OFFSET + 1] = g & 0xFF
    rpt[RGBI_OFFSET + 2] = b & 0xFF
    rpt[RGBI_OFFSET + 3] = 0xFF  # intensity; this lamp reports 1 level
    return bytes(rpt)


def parse_color(text: str) -> tuple[int, int, int]:
    t = text.strip().lower()
    if t in NAMED:
        return NAMED[t]
    if t.startswith("#"):
        t = t[1:]
    if "," in t:
        parts = [p.strip() for p in t.split(",")]
        if len(parts) != 3:
            raise SystemExit("expected R,G,B")
        rgb = (int(parts[0]), int(parts[1]), int(parts[2]))
    elif len(t) == 6 and all(c in "0123456789abcdef" for c in t):
        rgb = (int(t[0:2], 16), int(t[2:4], 16), int(t[4:6], 16))
    else:
        raise SystemExit(f"unknown colour: {text}")
    if any(c < 0 or c > 255 for c in rgb):
        raise SystemExit("RGB values must be 0–255")
    return rgb


def parse_pct(text: str) -> int:
    t = text.strip().rstrip("%")
    try:
        n = int(t)
    except ValueError as e:
        raise SystemExit("brightness must be 0–100") from e
    if n < 0 or n > 100:
        raise SystemExit("brightness must be 0–100")
    return n


def _open_dir_component(parent_fd: int, name: str) -> int:
    """Open (creating if needed) one path component under parent_fd.

    Never follows a symlink for this component, and rejects it outright if
    it turns out not to be a directory we own — so a symlink swapped into an
    intermediate directory (e.g. ~/.config itself) is caught at each step
    instead of only at the final component.
    """
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    try:
        fd = os.open(name, flags, dir_fd=parent_fd)
    except FileNotFoundError:
        try:
            os.mkdir(name, 0o700, dir_fd=parent_fd)
        except FileExistsError:
            pass
        fd = os.open(name, flags, dir_fd=parent_fd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
            raise OSError(f"{name} is not a private directory")
        return fd
    except Exception:
        os.close(fd)
        raise


def _open_state_dir() -> int:
    home_fd = os.open(
        str(pathlib.Path.home()),
        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
    )
    fd = home_fd
    owns_fd = False
    try:
        for part in STATE_DIR_PARTS:
            next_fd = _open_dir_component(fd, part)
            if owns_fd:
                os.close(fd)
            fd, owns_fd = next_fd, True
        os.fchmod(fd, 0o700)
        return fd
    except Exception:
        if owns_fd:
            os.close(fd)
        raise
    finally:
        os.close(home_fd)


def load_state() -> dict:
    try:
        dir_fd = _open_state_dir()
    except OSError:
        return {}
    try:
        fd = os.open(
            STATE_NAME,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
            dir_fd=dir_fd,
        )
    except OSError:
        os.close(dir_fd)
        return {}
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            return {}
        if st.st_size > MAX_STATE_BYTES:
            return {}
        data = os.read(fd, MAX_STATE_BYTES + 1)
        if len(data) > MAX_STATE_BYTES:
            return {}
        obj = json.loads(data.decode())
        return obj if isinstance(obj, dict) else {}
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError):
        return {}
    finally:
        os.close(fd)
        os.close(dir_fd)


def save_state(r: int, g: int, b: int, brightness: int, mode: str = "static") -> None:
    payload = (
        json.dumps(
            {"r": r, "g": g, "b": b, "brightness": brightness, "mode": mode},
            indent=2,
        )
        + "\n"
    ).encode()
    if len(payload) > MAX_STATE_BYTES:
        raise SystemExit("state too large")
    dir_fd = _open_state_dir()
    tmp = f".state.{os.getpid()}.{os.urandom(8).hex()}.tmp"
    fd = None
    try:
        fd = os.open(
            tmp,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=dir_fd,
        )
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            raise OSError("tmp is not a private regular file")
        written = 0
        while written < len(payload):
            written += os.write(fd, payload[written:])
        os.fsync(fd)
        os.close(fd)
        fd = None
        os.rename(tmp, STATE_NAME, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        os.fsync(dir_fd)
    except OSError as e:
        if fd is not None:
            os.close(fd)
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise SystemExit(f"could not write state: {e}") from e
    finally:
        os.close(dir_fd)


def hsv_rgb(h: float, s: float = 1.0, v: float = 1.0) -> tuple[int, int, int]:
    i = int(h * 6)
    f = h * 6 - i
    p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
    r, g, b = (
        (v, t, p),
        (q, v, p),
        (p, v, t),
        (p, q, v),
        (t, p, v),
        (v, p, q),
    )[i % 6]
    return int(r * 255), int(g * 255), int(b * 255)


def run_cycle(dev: pathlib.Path, brightness: int, period: float = 8.0) -> None:
    """Host-side hue cycle on the one-zone lamp. Stops on SIGTERM/SIGINT."""
    state = load_state()
    save_state(
        int(state.get("r", 255)),
        int(state.get("g", 255)),
        int(state.get("b", 255)),
        brightness,
        mode="cycle",
    )
    stop = False

    def halt(_signum, _frame):
        nonlocal stop
        stop = True

    signal.signal(signal.SIGTERM, halt)
    signal.signal(signal.SIGINT, halt)

    fd = os.open(dev, os.O_RDWR)
    try:
        _verify_hidraw_fd(fd)
        try:
            set_feature_fd(fd, bytes([REPORT_CONTROL, 0]))
        except OSError:
            pass
        t0 = time.time()
        while not stop:
            h = ((time.time() - t0) / period) % 1.0
            r, g, b = hsv_rgb(h)
            sr, sg, sb = scale_rgb(r, g, b, brightness)
            set_feature_fd(fd, build_multiupdate(sr, sg, sb))
            time.sleep(0.04)
    except OSError as e:
        if e.errno in (1, 13):
            raise SystemExit(
                f"permission denied on {dev}. Need udev 99-aero-rgb.rules (group wheel)."
            ) from e
        raise SystemExit(f"HIDIOCSFEATURE failed on {dev}: {e}") from e
    finally:
        os.close(fd)
    save_state(
        int(state.get("r", 255)),
        int(state.get("g", 255)),
        int(state.get("b", 255)),
        brightness,
        mode="static",
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Set the AERO X16 keyboard to one RGB colour (single zone)."
    )
    parser.add_argument(
        "color",
        nargs="?",
        help="hex (#1a6bff), R,G,B, name (red/blue/off), or cycle",
    )
    parser.add_argument("brightness", nargs="?", help="0–100 percent")
    parser.add_argument(
        "-b",
        "--brightness",
        dest="brightness_opt",
        help="0–100 percent (keeps last colour if no colour given)",
    )
    parser.add_argument("--dry-run", action="store_true", help="print packet, do not send")
    parser.add_argument("--device", help="hidraw path (default: LampArray interface 4)")
    parser.add_argument(
        "--dump-state",
        action="store_true",
        help="print state.json to stdout via a no-follow private read",
    )
    args = parser.parse_args()

    if args.dump_state:
        print(json.dumps(load_state(), separators=(",", ":")))
        return 0

    state = load_state()
    src = args.brightness_opt or args.brightness
    off = bool(args.color and args.color.strip().lower() in {"off", "black"})
    cycle = bool(args.color and args.color.strip().lower() == "cycle")

    if args.color is None and src is None:
        parser.print_help()
        if state:
            print(
                f"\nlast: #{int(state.get('r',0)):02x}{int(state.get('g',0)):02x}"
                f"{int(state.get('b',0)):02x}  brightness {int(state.get('brightness', 100))}%",
                file=sys.stderr,
            )
        return 0

    def remembered_rgb() -> tuple[int, int, int]:
        r0 = int(state.get("r", 0))
        g0 = int(state.get("g", 0))
        b0 = int(state.get("b", 0))
        if r0 == g0 == b0 == 0:
            return NAMED["blue"]
        return r0, g0, b0

    if cycle:
        if src is not None:
            brightness = parse_pct(src)
        else:
            brightness = int(state.get("brightness", 100)) or 100
        if args.dry_run:
            print(f"cycle  brightness {brightness}%")
            return 0
        dev = pathlib.Path(args.device) if args.device else find_hidraw()
        print(f"cycle via {dev}  brightness {brightness}%  (Ctrl-C to stop)")
        run_cycle(dev, brightness)
        return 0

    if off:
        r, g, b = remembered_rgb()
        brightness = 0
    elif args.color is None:
        r, g, b = remembered_rgb()
        brightness = parse_pct(src) if src is not None else int(state.get("brightness", 100))
    else:
        r, g, b = parse_color(args.color)
        if src is not None:
            brightness = parse_pct(src)
        else:
            brightness = 100

    sr, sg, sb = scale_rgb(r, g, b, 0 if off else brightness)

    print(
        f"#{r:02x}{g:02x}{b:02x}  brightness {0 if off else brightness}%  "
        f"lamp {sr:02x}{sg:02x}{sb:02x}"
    )
    if args.dry_run:
        return 0

    dev = pathlib.Path(args.device) if args.device else find_hidraw()
    apply_lamp(dev, sr, sg, sb)
    save_state(r, g, b, 0 if off else brightness, mode="off" if off else "static")
    print(f"sent via {dev}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
